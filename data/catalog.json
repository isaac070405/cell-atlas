            }
          ]
        },
        {
          "id": "fes",
          "name": {
            "en": "Fe–S cluster chain",
            "zh-Hant": "Fe–S 簇電子傳遞鏈"
          },
          "note": {
            "en": "Iron–sulfur clusters carry electrons from NDUFV1 through NDUFS1 and NDUFS8 to NDUFS7.",
            "zh-Hant": "鐵硫簇將電子由 NDUFV1 經 NDUFS1、NDUFS8 傳去 NDUFS7。"
          },
          "parts": [
            {
              "comp": [
                "SF4",
                "FES"
              ]
            }
          ]
        },
        {
          "id": "n2-q",
          "name": {
            "en": "Cluster N2 and the Q-site",
            "zh-Hant": "簇 N2 同 Q-site"
          },
          "note": {
            "en": "Last cluster N2 sits at the NDUFS2–NDUFS7 interface, at the mouth of the ubiquinone channel.",
            "zh-Hant": "最後一個簇 N2 喺 NDUFS2 同 NDUFS7 交界，即係泛醌通道入口。"
          },
          "parts": [
            {
              "entity": "iron-sulfur protein 2"
            },
            {
              "entity": "iron-sulfur protein 7"
            }
          ]
        },
        {
          "id": "pump",
          "name": {
            "en": "Membrane-arm proton pumps",
            "zh-Hant": "膜臂質子泵"
          },
          "note": {
            "en": "ND2, ND4 and ND5 are antiporter-like subunits that move protons across the inner membrane.",
            "zh-Hant": "ND2、ND4、ND5 係類反向轉運蛋白亞基，負責將質子泵過內膜。"
          },
          "parts": [
            {
              "entity": "chain (2|4|5)\\b"
            }
          ]
        }
      ]
    },
