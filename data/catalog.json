      "tour": [
        {
          "id": "fmn",
          "name": {
            "en": "NADH entry and FMN",
            "zh-Hant": "NADH 入口同 FMN"
          },
          "note": {
            "en": "Flavin at the tip of the matrix arm, in NDUFV1. NADH hands over two electrons here.",
            "zh-Hant": "位於基質臂頂端 NDUFV1 嘅黃素。NADH 喺度交出兩粒電子。"
          },
